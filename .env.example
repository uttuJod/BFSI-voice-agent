# Copy this file to .env and fill in your own values.
# Never commit .env or real credentials.

DEEPGRAM_API_KEY=
CARTESIA_API_KEY=
CARTESIA_VOICE_ID=

# vLLM OpenAI-compatible endpoint
VLLM_BASE_URL=http://127.0.0.1:8001/v1
VLLM_MODEL=bfsi-router

# Optional Hugging Face token for higher Hub rate limits
HF_TOKEN=

# Fast normal-turn endpointing
TURN_ENDPOINT_SILENCE_MS=550
TURN_ASR_SETTLE_MS=300

# More patient endpointing while verification digits are being spoken
VERIFY_ENDPOINT_SILENCE_MS=1600
VERIFY_ASR_SETTLE_MS=900

# Optional voice tuning
BARGE_CONFIRM_MS=120

# Domain pack: bfsi (default) or ecommerce. Changes corpus, FAISS index and eval defaults.
DOMAIN=bfsi

# Minimum voiced duration before a VAD onset during playback can become a barge-in
BARGE_MIN_SPEECH_MS=250

# Guaranteed-delivery pipeline for business writes
JOBS_ENABLED=1
JOBS_DB=results/jobs.db
JOBS_LEASE_S=30
APP_INSTANCE_ID=app

# Where per-turn latency and barge-in samples are appended
VOICE_METRICS_JSONL=results/voice_turn_samples.jsonl
BARGE_METRICS_JSONL=results/barge_in_samples.jsonl
